---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { formatCounter } from '../../lib/showcase-state';
import Icon from '../ui/Icon.astro';
/** The portal of «El espacio»: an architectural, domed frame that holds the real photo of
 * each view. The photo is always whole (contain) and sits below the dome; the space
 * around it is filled by a blurred, darkened echo of the same photo, so the room seems to
 * glow inside the frame. Double-buffered views: see scripts/space-tour.ts. */
interface PortalView {
  readonly image: ImageMetadata;
  readonly alt: string;
  readonly widths: readonly number[];
  readonly backdrop: string;
  readonly zoom: Record<string, string>;
}
interface Props { views: readonly PortalView[] }
const { views } = Astro.props;
---
<div class="tour-portal" data-tour-portal>
  <span class="tour-portal-glow" data-tour-glow aria-hidden="true"></span>
  <div class="tour-stage" id="tour-stage" data-tour-stage>
    {views.map((view, index) => (
      <figure class="tour-view" data-tour-view={index} hidden={index > 0} {...view.zoom}>
        <span class="tour-backdrop" aria-hidden="true" style={`--backdrop:url('${view.backdrop}')`}></span>
        <Picture src={view.image} alt={view.alt} formats={['avif', 'webp']} fallbackFormat="jpg" widths={[...view.widths]} sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 52vw, 70vw" quality={78} loading="lazy" decoding="async" draggable="false" />
        <div class="tour-fallback" role="alert">
          <Icon name="diamond" />
          <p>No pudimos cargar esta fotografía.</p>
          <button type="button" class="tour-retry" data-tour-retry>Reintentar</button>
        </div>
      </figure>
    ))}
    <span class="tour-vignette" aria-hidden="true"></span>
    <div class="tour-overlay">
      <p class="tour-counter" data-tour-counter aria-hidden="true">{formatCounter(0, views.length)}</p>
      <span class="tour-dots" aria-hidden="true">
        {views.map((_, index) => <span class="tour-dot" data-tour-dot={index} data-active={index === 0 ? '' : undefined}></span>)}
      </span>
      <button type="button" class="tour-zoom" data-tour-zoom hidden><Icon name="expand" /><span>Ampliar</span></button>
    </div>
  </div>
  <div class="tour-nav" data-tour-nav hidden>
    <button type="button" class="tour-step" data-tour-step="-1" aria-label="Ambiente anterior"><Icon name="arrow-left" /></button>
    <button type="button" class="tour-step" data-tour-step="1" aria-label="Ambiente siguiente"><Icon name="arrow-right" /></button>
  </div>
</div>
<style>
  /* Registered so the entrance light can travel around the frame (static where unsupported). */
  @property --sweep { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
  /* Geometry tokens (--portal-w, --portal-h, --dome, --photo-top) are set on .tour. */
  .tour-portal {
    --foot: 1.1rem;
    position: relative; z-index: 1; width: calc(var(--portal-w) + var(--frame) * 2); margin-inline: auto; padding: var(--frame);
    border: 1px solid #c5a36a8c;
    border-radius: 50% 50% calc(var(--foot) + var(--frame)) calc(var(--foot) + var(--frame)) / calc(var(--dome) + var(--frame)) calc(var(--dome) + var(--frame)) calc(var(--foot) + var(--frame)) calc(var(--foot) + var(--frame));
    background:
      radial-gradient(120% 60% at calc(50% + var(--px, 0) * 30%) calc(var(--py, 0) * 20% - 10%), #c5a36a2e, transparent 60%),
      linear-gradient(180deg, #1b4c3f, #0b2620 38%, #06130f);
    box-shadow: 0 0 0 .45rem #0a211b, 0 0 0 calc(.45rem + 1px) #c5a36a33, 0 2.75rem 5rem -1.5rem #000e, inset 0 1px 0 #f6e7c42e, inset 0 0 1.5rem #000a;
  }
  /* Camera mode: the portal is the plane z = 0 of the scene, between the far and near halves
   * of the rings (space-scene.ts). Rasterised as a layer only while the camera moves. */
  :global(luxe-space-tour[data-camera]) .tour-portal { z-index: 20; }
  :global(luxe-space-tour[data-camera-moving]) .tour-portal { will-change: transform; }
  /* Warm light around the portal; it breathes once when another view arrives. */
  .tour-portal-glow { position: absolute; z-index: -1; inset: -12% -18% -6%; background: radial-gradient(50% 45% at 50% 42%, #c5a36a2b, #103d3214 55%, transparent 72%); opacity: .8; pointer-events: none; }
  /* Light running once around the frame at the entrance (registered angle, see .tour). */
  .tour-portal::after { content: ''; position: absolute; inset: -1px; padding: 1px; border-radius: inherit; background: conic-gradient(from var(--sweep, 0deg) at 50% 50%, transparent 0 78%, #f6e7c4 88%, transparent 96%); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0); opacity: 0; pointer-events: none; }

  .tour-stage {
    position: relative; height: var(--portal-h); overflow: hidden; isolation: isolate;
    border: 1px solid #c5a36a73;
    border-radius: 50% 50% var(--foot) var(--foot) / var(--dome) var(--dome) var(--foot) var(--foot);
    background: radial-gradient(90% 70% at 50% 40%, #14473a, #050f0c 85%); touch-action: pan-y;
  }
  .tour-view { position: absolute; inset: 0; margin: 0; }
  .tour-backdrop { position: absolute; inset: -10%; background: var(--backdrop) center / cover no-repeat; filter: blur(24px) saturate(1.25) brightness(.68); transform: translate(calc(var(--px, 0) * 10px), calc(var(--py, 0) * 8px)) scale(1.08); }
  .tour-view :global(picture) { position: absolute; inset: var(--photo-top) clamp(.9rem, 5%, 1.75rem) 4.6rem; display: block; transform: translate(calc(var(--px, 0) * -5px), calc(var(--py, 0) * -4px)); }
  .tour-view :global(img) { display: block; width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 1.1rem 1.4rem #000c); user-select: none; -webkit-user-drag: none; }
  :global(luxe-space-tour[data-ready]) .tour-view { cursor: zoom-in; }
  /* Double buffer: a view being prepared takes its place invisibly until its photo is ready. */
  .tour-view[data-state='preparing'] { visibility: hidden; }
  /* Inner shadow: the photo sits inside a space, not on the page. */
  .tour-vignette { position: absolute; z-index: 1; inset: 0; border-radius: inherit; background: radial-gradient(80% 66% at 50% 54%, transparent 55%, #02080699 100%), linear-gradient(180deg, #0208068c, transparent 24%, transparent 80%, #020806b3); box-shadow: inset 0 0 2.5rem #000c, inset 0 1px 0 #f6e7c41f; pointer-events: none; }

  .tour-fallback { position: absolute; inset: 0; display: none; place-content: center; justify-items: center; gap: .75rem; padding: 1.5rem; color: #d3d8cf; text-align: center; }
  .tour-fallback :global(.icon) { width: 2.5rem; height: 2.5rem; color: var(--gold); }
  .tour-view[data-failed] .tour-fallback { display: grid; }
  .tour-view[data-failed] :global(picture), .tour-view[data-failed] .tour-backdrop { visibility: hidden; }
  :global(luxe-space-tour[data-ready]) .tour-view[data-failed] { cursor: default; }
  .tour-retry { min-height: 44px; padding: .5rem 1.1rem; border: 1px solid #c5a36a99; background: #101211cc; color: var(--ivory); font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; }
  .tour-retry:hover { border-color: var(--gold); color: var(--gold); }
  /* Slow connection: the current photo stays; a hairline says the next one is on its way. */
  .tour-stage::before { content: ''; position: absolute; z-index: 3; left: 18%; right: 18%; bottom: 4.1rem; height: 1px; background: linear-gradient(90deg, transparent, var(--gold), transparent); opacity: 0; pointer-events: none; }
  .tour-stage[data-loading]::before { opacity: 1; }

  /* The floating control bar, part of the architecture: position, active view, zoom. */
  .tour-overlay { position: absolute; z-index: 2; left: 50%; bottom: .85rem; display: flex; align-items: center; gap: .85rem; max-width: calc(100% - 1.5rem); padding: .3rem .3rem .3rem 1.05rem; border: 1px solid #c5a36a59; border-radius: 999px; background: linear-gradient(180deg, #0c231ce6, #050e0bf0); box-shadow: 0 .9rem 1.8rem -.6rem #000d, inset 0 1px 0 #f6e7c41f; transform: translateX(-50%); white-space: nowrap; }
  .tour-counter { color: var(--gold); font-size: .75rem; font-variant-numeric: tabular-nums; letter-spacing: .22em; }
  .tour-dots { display: flex; align-items: center; gap: .45rem; padding-inline: .85rem; border-inline: 1px solid #c5a36a33; }
  .tour-dot { width: .375rem; height: .375rem; border: 1px solid #c5a36a99; transform: rotate(45deg); }
  .tour-dot[data-active] { border-color: var(--gold); background: var(--gold); box-shadow: 0 0 .6rem #c5a36a99; transform: rotate(45deg) scale(1.35); }
  .tour-zoom { display: inline-flex; align-items: center; gap: .5rem; min-height: 44px; padding: .35rem 1rem; border: 1px solid #c5a36a66; border-radius: 999px; background: #101211b3; color: var(--ivory); font-size: .6875rem; letter-spacing: .14em; text-transform: uppercase; }
  .tour-zoom :global(.icon) { width: 1rem; height: 1rem; color: var(--gold); }
  .tour-zoom:hover { border-color: var(--gold); color: var(--gold); }
  .tour-zoom:focus-visible, .tour-step:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }
  .tour-zoom[hidden], .tour-nav[hidden] { display: none; }

  /* Arrows: two diamonds set into the frame, at the photo's height. */
  .tour-nav { position: absolute; z-index: 3; inset: calc(var(--frame) + var(--photo-top) + (var(--portal-h) - var(--photo-top) - 4.6rem) / 2) -1.6rem auto; display: flex; justify-content: space-between; transform: translateY(-50%); pointer-events: none; }
  .tour-step { position: relative; display: grid; place-items: center; width: 52px; height: 52px; padding: 0; border: 0; background: none; color: var(--ivory); pointer-events: auto; }
  .tour-step::before { content: ''; position: absolute; inset: 10px; border: 1px solid #c5a36ab3; background: linear-gradient(135deg, #12382ff2, #06120ef5); box-shadow: 0 .6rem 1.2rem -.4rem #000c, inset 0 1px 0 #f6e7c42e; transform: rotate(45deg); }
  .tour-step :global(.icon) { position: relative; width: 1.1rem; height: 1.1rem; }
  .tour-step:hover { color: var(--gold); }
  .tour-step:hover::before { border-color: var(--gold); }

  @container (max-width: 40rem) {
    /* Set on the frame edge, beside the photo rather than over it, and inside the page. */
    .tour-nav { inset-inline: -1.1rem; }
    .tour-overlay { gap: .6rem; padding-left: .9rem; }
    .tour-dots { gap: .38rem; padding-inline: .6rem; }
    .tour-zoom { padding-inline: .8rem; }
  }
  @container (max-width: 21rem) {
    .tour-dots { display: none; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .tour-backdrop, .tour-view :global(picture) { transition: transform 900ms cubic-bezier(.22, 1, .36, 1); }
    .tour-dot { transition: transform 360ms cubic-bezier(.22, 1, .36, 1), background-color 360ms ease, box-shadow 360ms ease; }
    .tour-stage[data-loading]::before { animation: tour-loading 1.1s ease-in-out infinite; }
    @keyframes tour-loading { from { transform: translateX(-40%); } to { transform: translateX(40%); } }
    :global(luxe-space-tour[data-reveal='pending']) .tour-portal { opacity: 0; }
    :global(luxe-space-tour[data-reveal='run']) .tour-portal { animation: tour-portal-in 820ms cubic-bezier(.22, 1, .36, 1) both; }
    :global(luxe-space-tour[data-reveal='run']) .tour-portal::after { animation: tour-sweep 1700ms 250ms cubic-bezier(.45, 0, .25, 1) both; }
    :global(luxe-space-tour[data-reveal='run']) .tour-view:not([hidden]) :global(img) { animation: tour-photo-in 1200ms cubic-bezier(.22, 1, .36, 1) both; }
    @keyframes tour-portal-in { from { opacity: 0; } to { opacity: 1; } }
    @keyframes tour-sweep { 0% { --sweep: 0deg; opacity: 0; } 15% { opacity: 1; } 85% { opacity: 1; } 100% { --sweep: 360deg; opacity: 0; } }
    @keyframes tour-photo-in { from { opacity: 0; transform: scale(1.045); } to { opacity: 1; transform: none; } }
  }
  :global(luxe-space-tour[data-lite]) .tour-backdrop { filter: brightness(.45); }
</style>
