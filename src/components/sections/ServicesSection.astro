---
import { mundoIntro, services, type ServiceGroup } from '../../data/services';
import { publicLinks } from '../../data/links';
import type { RenderableMedia, RenderableVideo } from '../../data/media';
import { spaceTour, type SpaceStop } from '../../data/spaces';
import { buildGlobe } from '../../data/globe';
import ExternalLink from '../ui/ExternalLink.astro';
import Icon from '../ui/Icon.astro';
import GlobePanel from './GlobePanel.astro';
interface Props { media: readonly RenderableMedia[]; videos?: readonly RenderableVideo[]; groups?: readonly ServiceGroup[]; stops?: readonly SpaceStop[] }
const { media, videos = [], groups = services, stops = spaceTour } = Astro.props;
const globe = buildGlobe(groups, media, videos, stops);
const { specialties, panels, initial, hero } = globe;
const first = specialties[0]!;
const firstPanel = panels.find((panel) => panel.key === (hero ?? first.featured))!;
const total = String(specialties.length).padStart(2, '0');
const names = new Map(specialties.map((specialty) => [specialty.id, specialty.name]));
const photoCount = panels.filter((panel) => panel.kind === 'photo').length;
const videoCount = panels.filter((panel) => panel.kind === 'video').length;
const stageLabel = `El mundo LUXE: ${photoCount} fotografías${videoCount ? ` y ${videoCount} ${videoCount === 1 ? 'video real' : 'videos reales'}` : ' reales'}`;
// Server copy: the welcome when a clip leads the globe, otherwise the first specialty.
const opening = hero
  ? { mode: 'intro', index: mundoIntro.eyebrow, name: mundoIntro.title, description: '', message: mundoIntro.message }
  : { mode: 'specialty', index: `${first.number} / ${total}`, name: first.name, description: first.description, message: first.message };
---
<section id="servicios" class="services section-space scene on-light" aria-labelledby="servicios-title">
  <div class="container">
    <luxe-specialties class="signature">
      {/* The heading lives inside the scene grid: on desktop it heads the left column, with
        * the selector and the main action, while the world takes the right one. */}
      <div class="section-heading signature-head">
        <div><p class="eyebrow">01 / El mundo LUXE</p><h2 id="servicios-title">Un mundo de belleza,<br /><em>en un solo lugar.</em></h2></div>
        <p class="section-intro">Explorá nuestros servicios, descubrí cada especialidad y encontrá tu próximo momento LUXE.</p>
      </div>
      <div class="signature-list" data-specialty-list>
        <ol class="service-index" data-specialty-index>
          {specialties.map((specialty) => (
            <li class="service-row" id={`service-${specialty.id}`} data-specialty-row={specialty.id}>
              <span class="service-number" aria-hidden="true">{specialty.number}</span>
              <h3 data-specialty-name>{specialty.name}</h3>
              <p>{specialty.description}</p>
              {specialty.works && (
                <a class="service-link" href="#trabajos" data-showcase-link={specialty.category}>Ver trabajos<span class="sr-only"> de {specialty.name}</span><Icon name="arrow-right" /></a>
              )}
            </li>
          ))}
        </ol>
        <span class="signature-indicator" data-specialty-indicator aria-hidden="true"></span>
        <span class="list-more" data-list-more aria-hidden="true"><Icon name="arrow-right" /></span>
      </div>
      <div class="globe-panel" id="specialty-panel" data-specialty-panel>
        <div class="globe-stage" data-globe-stage role="group" aria-label={stageLabel}>
          <span class="globe-halo" aria-hidden="true"></span>
          <div class="globe-world">
            <div class="globe-rotor" data-globe-rotor style={`transform: rotateX(${initial.pitch}deg) rotateY(${initial.yaw}deg)`}>
              {panels.map((panel) => <GlobePanel panel={panel} specialtyName={panel.specialtyId ? names.get(panel.specialtyId) : undefined} />)}
            </div>
            <div class="globe-core" aria-hidden="true">
              <svg viewBox="0 0 100 80" fill="none" focusable="false"><path d="M20 12H80L96 32 50 72 4 32 20 12ZM4 32H96M20 12 32 32 50 72 68 32 80 12M32 32 50 12 68 32" stroke="currentColor" stroke-width="1.4" /></svg>
              <span>LUXE</span>
            </div>
          </div>
          <p class="globe-hint" data-globe-hint aria-hidden="true" hidden><span></span>Arrastrá para explorar</p>
          <p class="sr-only" id="globe-help" hidden>Flechas: girar el mundo en cualquier dirección. Enter: ampliar la foto o el video destacado.</p>
        </div>
        <div class="globe-copy" data-globe-copy data-mode={opening.mode}>
          <div class="globe-copy-main">
            <p class="globe-index" data-specialty-slot="index">{opening.index}</p>
            <p class="globe-name" data-specialty-slot="name">{opening.name}</p>
            <span class="globe-rule" aria-hidden="true"><span class="rule-line" data-specialty-slot="rule"><span class="rule-glint"></span></span><Icon name="diamond" /></span>
            <p class="globe-description" data-specialty-slot="description">{opening.description}</p>
            <p class="globe-message" data-specialty-slot="message">{opening.message}</p>
            <p class="globe-caption" data-specialty-slot="caption">{firstPanel.caption}</p>
          </div>
          <div class="globe-side">
            <div class="globe-controls" role="group" aria-label="Girar el globo" data-globe-controls hidden>
              <button type="button" class="globe-turn" data-globe-turn="left" aria-label="Girar a la izquierda"><Icon name="arrow-left" /></button>
              <button type="button" class="globe-turn" data-globe-turn="up" aria-label="Inclinar hacia arriba"><Icon name="arrow-up" /></button>
              <button type="button" class="globe-turn" data-globe-turn="down" aria-label="Inclinar hacia abajo"><Icon name="arrow-down" /></button>
              <button type="button" class="globe-turn" data-globe-turn="right" aria-label="Girar a la derecha"><Icon name="arrow-right" /></button>
              <button type="button" class="globe-zoom" data-globe-zoom><Icon name="expand" /><span data-globe-zoom-label>Ampliar</span></button>
            </div>
            <div class="globe-actions" data-specialty-slot="actions">
              {publicLinks.booking && <ExternalLink href={publicLinks.booking} class="button signature-cta">Reservar mi cita <Icon name="arrow-up-right" /></ExternalLink>}
              <a class="text-link globe-works" href="#trabajos" data-specialty-slot="works" data-showcase-link={first.category} hidden={Boolean(hero) || !first.works}>Ver trabajos <Icon name="arrow-right" /></a>
            </div>
          </div>
        </div>
        <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-specialty-status></p>
      </div>
      <div class="services-cta">
        {publicLinks.booking && <ExternalLink href={publicLinks.booking} class="button button--emerald">Ver servicios y reservar <Icon name="arrow-up-right" /></ExternalLink>}
        <p>Precios, duración y disponibilidad se confirman al reservar en línea.</p>
      </div>
      <script type="application/json" data-globe-data set:html={JSON.stringify({ initial, specialties, hero, intro: mundoIntro })} />
    </luxe-specialties>
  </div>
</section>
<script is:inline>
  // Globe photos load only as the globe approaches the viewport, so they never compete with
  // the hero. Independent of the globe controller: a failed module never leaves it empty.
  (() => {
    const stage = document.querySelector('[data-globe-stage]');
    const mount = () => {
      document.querySelectorAll('template[data-globe-photo]').forEach((template) => template.replaceWith(template.content.cloneNode(true)));
      // The clips now exist: the globe's video director may start the one in front.
      stage?.dispatchEvent(new CustomEvent('globe:mounted'));
    };
    if (!stage || !('IntersectionObserver' in window)) { mount(); return; }
    const observer = new IntersectionObserver((records) => {
      if (!records.some((record) => record.isIntersecting)) return;
      observer.disconnect();
      mount();
    }, { rootMargin: '300px 0px' });
    observer.observe(stage);
  })();
</script>
<script>import '../../scripts/specialties';</script>
<style>
  .signature { display: grid; gap: 1.25rem; }
  .signature-list { position: relative; min-width: 0; }
  .service-index { margin: 0; padding: 0; list-style: none; border-top: 1px solid #103d3240; }
  .service-row { position: relative; display: grid; grid-template-columns: 2.25rem 1fr; column-gap: .75rem; padding-block: 1.35rem; border-bottom: 1px solid #103d3240; }
  .service-row::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 1px; background: var(--emerald); transform: scaleX(0); transform-origin: 0 50%; pointer-events: none; }
  .service-number { grid-row: 1 / span 3; padding-top: .55rem; color: var(--emerald); font-size: .6875rem; letter-spacing: .14em; }
  h3 { margin: 0; font: 400 clamp(1.75rem, 4.2cqi, 3.1rem)/1.1 var(--font-display); letter-spacing: -.02em; }
  .service-row p { margin-top: .35rem; max-width: 30rem; color: #3d4741; font-size: .9375rem; line-height: 1.6; }
  .service-link { position: relative; z-index: 1; justify-self: start; display: inline-flex; align-items: center; gap: .6rem; min-height: 44px; margin-top: .25rem; color: var(--emerald); font-size: .75rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; text-decoration: none; }
  .service-link :global(.icon) { width: 1rem; height: 1rem; }

  /* Enhanced rows: the heading becomes a real button stretched over the row. */
  .service-row :global(.signature-trigger) { margin: 0; padding: 0; border: 0; background: none; color: inherit; font: inherit; letter-spacing: inherit; text-align: left; cursor: pointer; }
  .service-row :global(.signature-trigger)::after { content: ''; position: absolute; inset: 0; }
  .service-row[data-active] h3 { color: var(--emerald); }
  .service-row[data-active] .service-number { font-weight: 700; }
  .signature-indicator { position: absolute; top: 0; left: 0; width: 2px; height: 1px; background: #b8924f; transform-origin: 0 0; opacity: 0; pointer-events: none; transform: translate(-1rem, var(--y, 0px)) scaleY(var(--h, 0)); }
  luxe-specialties[data-ready] .signature-indicator { opacity: 1; }
  luxe-specialties[data-ready] .signature-indicator[data-none] { opacity: 0; }
  .list-more { display: none; }

  /* The globe's set: deep emerald, a soft light behind the sphere, the copy beneath it. */
  .globe-panel { position: relative; display: grid; min-width: 0; background: radial-gradient(70% 55% at 50% 40%, #1a5545 0%, #0d3329 48%, #071a14 100%); color: var(--ivory); }
  .globe-stage { position: relative; container: globe / size; width: min(100%, 40rem); aspect-ratio: 1; margin-inline: auto; perspective: 1500px; perspective-origin: 50% 46%; touch-action: pan-y; -webkit-user-select: none; user-select: none; --R: 39cqw; }
  /* Without JS the globe is a picture and the page scrolls over it. Once the world can turn,
   * a finger on it belongs to the world alone: it rolls in every direction (scripts/globe-rotor.ts)
   * and the page holds still until the finger lifts; touches that start outside it scroll as
   * usual. Two fingers still zoom the page where pinch-zoom is understood (`none` elsewhere).
   * No iOS image menu under a finger that rests before turning. */
  luxe-specialties[data-ready] .globe-stage { touch-action: none; -webkit-touch-callout: none; }
  @supports (touch-action: pinch-zoom) {
    luxe-specialties[data-ready] .globe-stage { touch-action: pinch-zoom; }
  }
  .globe-stage:focus-visible { outline: 2px solid var(--gold); outline-offset: -6px; }
  luxe-specialties[data-ready] .globe-stage { cursor: grab; }
  luxe-specialties[data-ready] .globe-stage[data-dragging] { cursor: grabbing; }
  .globe-halo { position: absolute; inset: 14%; border-radius: 50%; background: radial-gradient(circle, #c5a36a1f 0%, #c5a36a08 52%, transparent 70%); box-shadow: inset 0 0 0 1px #c5a36a1a; pointer-events: none; }
  /* Light of the set: a warm key light from above and a soft floor beneath the world. */
  .globe-stage::before { content: ''; position: absolute; inset: 0; background: radial-gradient(42% 30% at 50% 8%, #e5c89114, transparent 70%); pointer-events: none; }
  .globe-stage::after { content: ''; position: absolute; left: 22%; right: 22%; bottom: 7%; height: 7%; border-radius: 50%; background: radial-gradient(closest-side, #000a, transparent); pointer-events: none; }
  .globe-world { position: absolute; inset: 0; transform-style: preserve-3d; }
  .globe-rotor { position: absolute; inset: 0; transform-style: preserve-3d; will-change: transform; }
  .globe-core { position: absolute; top: 50%; left: 50%; display: grid; justify-items: center; gap: .3rem; width: 18cqw; margin: -8cqw 0 0 -9cqw; color: var(--gold); pointer-events: none; }
  .globe-core svg { width: 62%; }
  .globe-core span { font: 400 3.4cqw/1 var(--font-display); letter-spacing: .32em; text-indent: .32em; color: var(--ivory); }
  .globe-hint { position: absolute; left: 50%; bottom: 3%; display: flex; align-items: center; gap: .6rem; color: #c1c6bd; font-size: .6875rem; letter-spacing: .16em; text-transform: uppercase; transform: translateX(-50%); pointer-events: none; white-space: nowrap; }
  .globe-hint span { width: 1.5rem; height: 1px; background: var(--gold); }

  .globe-copy { position: relative; display: grid; gap: 1.25rem; min-width: 0; padding: clamp(1.25rem, 3cqi, 2.25rem); border-top: 1px solid #c5a36a33; background: #0b2620; }
  .globe-index { color: var(--gold); font-size: .6875rem; letter-spacing: .22em; text-transform: uppercase; }
  /* The welcome line under the first clip: editorial, a little quieter than a specialty name. */
  .globe-copy[data-mode='intro'] .globe-name { max-width: 22ch; font-size: var(--intro-size); line-height: 1.12; }
  /* Two lines of the welcome are reserved for every title (text on the baseline), so going
   * from the welcome to a specialty and back never moves the page. */
  .globe-copy { --intro-size: clamp(1.45rem, 2.9cqi, 2.4rem); }
  .globe-name { display: flex; align-items: flex-end; min-height: calc(var(--intro-size) * 2.24); }
  .globe-copy[data-mode='intro'] .globe-description { display: none; }
  .globe-name { margin-top: .45rem; font: 400 clamp(1.9rem, 3.4cqi, 2.8rem)/1.06 var(--font-display); letter-spacing: -.02em; }
  .globe-rule { display: flex; align-items: center; gap: .6rem; margin: .75rem 0 .8rem; color: var(--gold); }
  .rule-line { position: relative; display: block; width: 3rem; height: 1px; background: currentColor; transform-origin: 0 50%; }
  .rule-glint { position: absolute; top: -1px; left: 0; width: .9rem; height: 3px; border-radius: 2px; background: linear-gradient(90deg, transparent, #fff3d6, transparent); opacity: 0; }
  .globe-rule :global(.icon) { width: 1rem; height: 1rem; }
  .globe-description { color: var(--ivory); font-size: .9375rem; font-weight: 600; }
  /* Two lines reserved: short and long messages (and the welcome) keep the same height. */
  .globe-message { max-width: 30rem; min-height: 3.4em; margin-top: .4rem; color: #d3d8cf; font-size: .9375rem; line-height: 1.7; }
  .globe-caption { margin-top: .5rem; color: #b7beb4; font-size: .75rem; letter-spacing: .03em; }
  .globe-caption::before { content: '— '; color: #c5a36a99; }
  .globe-side { display: grid; gap: 1rem; align-content: start; }
  .globe-controls { display: flex; flex-wrap: wrap; align-items: center; gap: .25rem; }
  .globe-controls[hidden] { display: none; }
  .globe-turn { position: relative; display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 0; background: none; color: var(--ivory); }
  .globe-turn::before { content: ''; position: absolute; inset: 8px; border: 1px solid #c5a36a80; transform: rotate(45deg); }
  .globe-turn :global(.icon) { position: relative; width: 1.1rem; height: 1.1rem; }
  .globe-turn:hover { color: var(--gold); }
  .globe-zoom { display: inline-flex; align-items: center; gap: .55rem; min-height: 44px; margin-left: .5rem; padding: .4rem .9rem; border: 1px solid #c5a36a59; background: none; color: var(--ivory); font-size: .6875rem; letter-spacing: .14em; text-transform: uppercase; }
  .globe-zoom :global(.icon) { width: 1rem; height: 1rem; color: var(--gold); }
  .globe-zoom:hover { border-color: var(--gold); color: var(--gold); }
  .globe-zoom[hidden] { display: none; }
  .globe-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .9rem 1.5rem; }
  .globe-actions .signature-cta { flex: 1 1 14rem; max-width: 22rem; }
  .globe-works { color: var(--ivory); }
  .on-light .globe-panel .text-link:hover { color: var(--gold); }
  .on-light .globe-panel :global(:focus-visible) { outline-color: var(--gold); }

  .services-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; margin-top: clamp(2rem, 4cqi, 3rem); }
  .services-cta p { max-width: 26rem; color: #3d4741; font-size: .8125rem; line-height: 1.55; }

  /* Desktop scene: the world is as large as the screen height allows, never taller. */
  @media (min-width: 64rem) and (min-height: 34rem) {
    .globe-panel { --globe-cap: var(--scene-avail); }
  }
  /* Phones: a lighter globe — fewer pieces, no back plates, a closer camera. */
  @container globe (max-width: 30rem) {
    .globe-rotor :global([data-filler]), .globe-rotor :global(.gp-back) { display: none; }
  }
  @container (max-width: 39.99rem) {
    .globe-stage { perspective: 1150px; --R: 36.5cqw; }
  }
  @container (min-width: 40rem) {
    .globe-copy { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); align-items: end; column-gap: 2rem; }
  }
  @container (min-width: 48rem) {
    luxe-specialties:not([data-ready]) .service-row { grid-template-columns: 3.5rem minmax(14rem, 1fr) minmax(0, 1.1fr) 11rem; align-items: center; column-gap: 2rem; padding-block: 1.6rem; }
    luxe-specialties:not([data-ready]) .service-number { grid-row: auto; padding-top: 0; }
    luxe-specialties:not([data-ready]) .service-row p { margin-top: 0; }
    luxe-specialties:not([data-ready]) .service-link { margin-top: 0; justify-self: end; }
  }
  /* Phones and tablets with JS: a compact horizontal selector right above the globe. */
  @container (max-width: 59.99rem) {
    luxe-specialties[data-ready] .signature-list { margin-inline: calc(var(--gutter) * -1); }
    luxe-specialties[data-ready] .service-index { display: flex; gap: .5rem; padding: .25rem var(--gutter) .5rem; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x proximity; scroll-padding-inline: var(--gutter); scrollbar-width: none; border-top: 0; }
    luxe-specialties[data-ready] .service-index::-webkit-scrollbar { display: none; }
    luxe-specialties[data-ready] .service-row { flex: none; display: flex; align-items: center; gap: .55rem; min-height: 48px; padding: .55rem 1rem; border: 1px solid #103d3240; border-radius: 999px; scroll-snap-align: start; }
    luxe-specialties[data-ready] .service-number { padding-top: 0; }
    luxe-specialties[data-ready] h3 { font-size: 1.05rem; line-height: 1.2; white-space: nowrap; }
    luxe-specialties[data-ready] .service-row p, luxe-specialties[data-ready] .service-link, luxe-specialties[data-ready] .signature-indicator { display: none; }
    luxe-specialties[data-ready] .service-row[data-active] { background: var(--emerald); border-color: var(--emerald); color: var(--ivory); }
    luxe-specialties[data-ready] .service-row[data-active] h3 { color: var(--ivory); }
    luxe-specialties[data-ready] .service-row[data-active] .service-number { color: var(--gold); }
    luxe-specialties[data-ready] .service-row::after { display: none; }
    /* More chips beyond the edge: a fade and an arrow say so. */
    .list-more { position: absolute; top: .25rem; bottom: .5rem; right: 0; display: grid; place-items: center end; width: 4.5rem; padding-right: .6rem; background: linear-gradient(90deg, #f1eadf00, var(--ivory) 62%); color: var(--emerald); opacity: 0; pointer-events: none; }
    .list-more :global(.icon) { width: 1.1rem; height: 1.1rem; }
    .signature-list[data-more] .list-more { opacity: 1; }
  }
  /* Desktop: one scene. Left, the invitation (heading, selector, main action), centred in its
   * column; right, the world with its contextual copy as a side rail. Spare height goes to the
   * outer rows, so the left column stays together instead of spreading apart. */
  @container (min-width: 60rem) {
    .signature { grid-template-columns: minmax(0, .62fr) minmax(0, 1.38fr); grid-template-rows: 1fr auto auto auto 1fr; column-gap: clamp(2rem, 4cqi, 4.5rem); row-gap: 0; }
    .signature-head { grid-column: 1; grid-row: 2; grid-template-columns: 1fr; gap: clamp(.75rem, 2svh, 1.25rem); margin-bottom: clamp(1rem, 2.8svh, 2.5rem); }
    .signature-head h2 { font-size: clamp(2.1rem, min(3.6cqi, 5.8svh), 3.6rem); }
    .signature-head .section-intro { justify-self: start; max-width: 25rem; padding-bottom: 0; }
    .signature-list { grid-column: 1; grid-row: 3; }
    .services-cta { grid-column: 1; grid-row: 4; gap: .7rem 1.5rem; margin-top: clamp(1rem, 2.6svh, 2.25rem); }
    .globe-panel { grid-column: 2; grid-row: 1 / -1; align-self: center; grid-template-columns: minmax(0, 1fr) minmax(14rem, 16.5rem); }
    .globe-stage { width: min(100%, 44rem, var(--globe-cap, 44rem)); align-self: center; }
    .globe-copy { grid-template-columns: 1fr; align-content: center; padding: clamp(1.1rem, 1.9cqi, 1.9rem); border-top: 0; border-left: 1px solid #c5a36a33; }
    .globe-copy { --intro-size: clamp(1.4rem, 2.1cqi, 1.9rem); }
    .globe-name { min-height: calc(var(--intro-size) * 3.36); }
    .service-row { grid-template-columns: 2.75rem minmax(0, 1fr) auto; column-gap: 1rem; align-items: center; padding-block: 1.15rem; }
    .service-number { grid-row: 1 / span 2; padding-top: 0; }
    .service-row h3 { grid-column: 2; font-size: clamp(1.6rem, 2.4cqi, 2.25rem); }
    .service-row p { grid-column: 2; max-width: 22rem; font-size: .875rem; }
    .service-link { grid-column: 3; grid-row: 1 / span 2; margin-top: 0; }
    .globe-works { display: none; }
    /* With JS the selector is a compact index (number, name, works); the chosen specialty's
     * description is told beside the world, where it is being shown. Without JS every row
     * keeps its description. */
    luxe-specialties[data-ready] .service-row { padding-block: clamp(.45rem, 1.25svh, .95rem); }
    luxe-specialties[data-ready] .service-row p { display: none; }
    luxe-specialties[data-ready] .service-row h3 { font-size: clamp(1.45rem, min(2.2cqi, 3.9svh), 2.1rem); }
    luxe-specialties[data-ready] .service-row { grid-template-columns: 2.25rem minmax(0, 1fr) auto; column-gap: .75rem; }
    luxe-specialties[data-ready] .service-link { gap: .45rem; font-size: .6875rem; letter-spacing: .07em; }
    .globe-actions .signature-cta { flex: 1 1 100%; max-width: none; }
  }
  /* The welcome, once (scripts/specialties.ts): pending while the globe is still below. */
  /* Opacity never touches the preserve-3d world (it would flatten it for the duration and let
   * the core show through the clip): the stage fades, the world only scales. */
  luxe-specialties[data-intro='pending'] .globe-stage { opacity: 0; }
  luxe-specialties[data-intro='pending'] .globe-world { transform: scale(.86); }
