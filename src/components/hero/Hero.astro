---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { luxe, type LuxeConfig } from '../../data/luxe';
import { publicLinks } from '../../data/links';
import ExternalLink from '../ui/ExternalLink.astro';
import Icon from '../ui/Icon.astro';
import OpenNow from '../ui/OpenNow.astro';

// The reception (or the admin's replacement), resolved in data/media.ts.
interface Props { photo: { readonly image: ImageMetadata; readonly alt: string } | null }
const { photo } = Astro.props;
const reception = photo?.image ?? null;
const width = reception ? Math.min(1086, reception.width) : 0;
const widths = reception ? [...new Set([480, 720].filter((candidate) => candidate < width).concat(width))] : [];
const { hours } = luxe.contact as LuxeConfig['contact'];
---

<section class:list={['hero', { 'hero--photo': reception }]} aria-labelledby="bienvenida">
  <div class="hero__copy">
    <p class="eyebrow">{luxe.introduction.eyebrow}</p>
    <h1 id="bienvenida" data-intro-reveal>
      {/* Explicit spaces (the spans are blocks, so they are invisible) and the gold period
          drawn by CSS: the heading text reads «Bienvenidos a LUXE Centro de Belleza». */}
      <span class="welcome">Bienvenidos a</span>{' '}
      <span class="hero__name">LUXE</span>{' '}
      <span class="hero__descriptor">Centro de Belleza</span>
    </h1>
    <p class="hero__message">{luxe.introduction.title}<br /><em>{luxe.introduction.accent}</em></p>
    <p class="hero__description">{luxe.introduction.description}</p>
    <div class="hero__actions">
      {publicLinks.booking && <ExternalLink href={publicLinks.booking} class="button hero__book">Reservar cita <Icon name="arrow-up-right" /></ExternalLink>}
      <a class="hero__link" href="#ubicacion">Encontranos en Concepción <span aria-hidden="true">↗</span></a>
    </div>
  </div>

  {reception ? (
    <figure class="hero__scene">
      <Picture
        src={reception}
        alt={photo!.alt}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={widths}
        sizes="(min-width: 1440px) 850px, (min-width: 768px) 60vw, 100vw"
        width={width}
        height={Math.round((width * reception.height) / reception.width)}
        quality={78}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <figcaption><span>El espacio LUXE</span><span aria-hidden="true">01 / Recepción</span></figcaption>
    </figure>
  ) : (
    <div class="hero__unavailable"><p>Un espacio para el cuidado<br />y la belleza.</p></div>
  )}

  <div class="hero__base">
    <div class="hero__where">
      <p>{luxe.location}</p>
      {hours.status === 'confirmed' && <div class="hero__open"><OpenNow schedule={hours.value} /></div>}
    </div>
    <a href="#servicios" aria-label="Descubrí LUXE: ir a las especialidades"><span>Descubrí LUXE</span><span class="scroll-mark" aria-hidden="true">↓</span></a>
  </div>
</section>

<style>
  .hero { position: relative; isolation: isolate; display: grid; background: var(--deep); }
  .hero__copy { position: relative; z-index: 2; grid-row: 2; padding: 1.75rem var(--gutter) 1.5rem; }
  .eyebrow { font-size: .6875rem; letter-spacing: .22em; }
  h1 { font-family: var(--font-display); font-weight: 400; margin-block: 1.15rem 1.4rem; line-height: 1; }
  .welcome { display: block; font-size: clamp(1.5rem, 3.6vw, 3.4rem); letter-spacing: -.025em; }
  .hero__name { display: block; font-size: clamp(5.8rem, 24vw, 10rem); line-height: .98; letter-spacing: -.025em; margin: .35rem 0 .75rem -.055em; }
  .hero__name::after { content: '.'; color: var(--gold); }
  .hero__descriptor { display: block; font-family: var(--font-body); font-size: .75rem; text-transform: uppercase; letter-spacing: .31em; line-height: 1.5; }
  .hero__message { font: 400 clamp(1.35rem, 2.2vw, 2rem)/1.25 var(--font-display); }
  .hero__message em { color: var(--gold); }
  .hero__description { max-width: 26rem; color: var(--color-muted); margin-top: 1rem; font-size: .9375rem; line-height: 1.65; }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1.75rem; margin-top: 1.4rem; }
  .hero__book { flex: 0 1 auto; }
  .hero__link { display: inline-flex; align-items: center; justify-content: space-between; gap: 1.5rem; min-height: 48px; padding: .6rem 0; border-bottom: 1px solid var(--gold); font-size: .8125rem; text-decoration: none; }
  .hero__link span { color: var(--gold); font-size: 1.2rem; }
  .hero__scene { position: relative; grid-row: 1; min-width: 0; height: clamp(14rem, 66vw, 24rem); overflow: hidden; }
  .hero__scene :global(picture), .hero__scene :global(img) { width: 100%; height: 100%; display: block; }
  .hero__scene :global(img) { object-fit: cover; object-position: 50% 66%; }
  figcaption { position: absolute; inset: auto 0 0; display: flex; justify-content: space-between; gap: 1rem; padding: 2rem var(--gutter) 1rem; background: linear-gradient(transparent, #071610eb); font-size: .625rem; text-transform: uppercase; letter-spacing: .15em; }
  .hero__unavailable { grid-row: 1; min-height: 14rem; display: grid; place-items: center; padding: var(--gutter); border-top: var(--border-thin); font: italic 2rem/1.3 var(--font-display); color: var(--gold); }
  .hero__base { position: relative; z-index: 2; display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.1rem var(--gutter); font-size: .6875rem; border-bottom: 1px solid #c5a36a44; }
  .hero__where { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1.25rem; min-width: 0; }
  .hero__base p { max-width: 12rem; }
  .hero__base a { min-height: 44px; display: flex; align-items: center; gap: 1rem; text-decoration: none; }
  .hero__base a > span:first-child { display: none; }
  .scroll-mark { display: grid; place-items: center; width: 36px; height: 44px; border: 1px solid #c5a36a88; border-radius: 50%; font-size: 1rem; color: var(--gold); }
  @media (min-width: 48rem) {
    /* The base bar (location + scroll cue) stays on the first screen, above the action dock. */
    .hero { min-height: min(830px, max(34rem, calc(100svh - 6.25rem - var(--dock-clearance, 0px)))); grid-template-columns: 46% 54%; }
    .hero__copy { grid-column: 1; grid-row: 1; padding-block: clamp(3rem, 7vh, 6rem); align-self: center; }
    .hero__name { font-size: clamp(7.5rem, 12vw, 12rem); }
    .hero__scene { position: absolute; inset: 0 0 0 40%; height: 100%; z-index: -1; }
    .hero__scene::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, var(--deep), #0a211b00 23%), linear-gradient(0deg, #0a211bd9, transparent 20%); }
    .hero__scene :global(img) { object-position: 50% 58%; }
    figcaption { left: auto; top: 2rem; bottom: auto; right: var(--gutter); padding: .5rem .8rem; background: #101211d9; }
    figcaption span:last-child { display: none; }
    .hero__unavailable { grid-column: 2; grid-row: 1; border-top: 0; }
    .hero__base { grid-column: 1 / -1; align-self: end; padding-block: 1rem; }
    .hero__base p { max-width: none; }
    .hero__base a > span:first-child { display: inline; }
  }
  /* Desktop scene: the whole welcome (name, message, actions and the base bar) inside one
   * screen. Display sizes follow the screen height as well as its width. */
  @media (min-width: 64rem) and (min-height: 34rem) {
    .hero { min-height: min(830px, max(32rem, calc(100svh - 6.25rem - var(--dock-clearance, 0px)))); }
    .hero__copy { padding-block: clamp(1.25rem, 4.6svh, 5rem); }
    h1 { margin-block: clamp(.6rem, 2svh, 1.15rem) clamp(.8rem, 2.6svh, 1.4rem); }
    .welcome { font-size: clamp(1.6rem, min(3.6vw, 5.8svh), 3.4rem); }
    .hero__name { font-size: clamp(6rem, min(12vw, 18.6svh), 12rem); margin-block: .2rem .55rem; }
    .hero__message { font-size: clamp(1.4rem, min(2.2vw, 3.8svh), 2rem); }
    .hero__description { margin-top: clamp(.6rem, 1.6svh, 1rem); }
    .hero__actions { margin-top: clamp(1rem, 3svh, 1.75rem); }
    .hero__base { padding-block: clamp(.6rem, 1.6svh, 1rem); }
  }
  @media (min-width: 90rem) {
    .hero__copy { padding-left: max(var(--gutter), calc((100vw - var(--container-wide)) / 2)); }
    .hero__base { padding-inline: max(var(--gutter), calc((100vw - var(--container-wide)) / 2)); }
  }
  @media (max-width: 22rem) {
    .hero__name { font-size: clamp(3.2rem, 24vw, 5.8rem); }
    .hero__descriptor { letter-spacing: .15em; }
    .hero__base { flex-wrap: wrap; }
    .hero__link { flex-wrap: wrap; gap: .5rem; }
  }
</style>
