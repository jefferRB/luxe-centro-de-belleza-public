# Build output and generated types
dist/
.astro/
.luxe-build/

# Dependencies
node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Environment and credentials (only .env.example is tracked)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# Admin: local photo store, published releases and credentials (never commit)
.luxe-media/
.luxe-site/

# Screenshots and recordings of the production site: client photographs, logo and client
# work. Ignored until the business's written authorization is recorded in
# showcase/production.json (see scripts/verify-publication.ts); then remove this line.
showcase/production/

# Test and browser-automation artifacts
test-results/
playwright-report/
blob-report/
playwright/.cache/
.playwright-mcp/

# Archives and backups: the repository ships source, not packages
*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.tgz
*.bak
*.backup

# Editors and OS
.idea/
.DS_Store
Thumbs.db
desktop.ini
