---
import { portfolioCategories, type PortfolioItem } from '../../data/portfolio';
import { publicLinks } from '../../data/links';
import { previewsUnapprovedMedia } from '../../data/media';
import { ALL_CATEGORY, formatCounter } from '../../lib/showcase-state';
import ExternalLink from '../ui/ExternalLink.astro';
import Icon from '../ui/Icon.astro';
import ShowcasePhoto from './ShowcasePhoto.astro';
interface Props { items: readonly PortfolioItem[] }
const { items } = Astro.props;
const first = items[0];
const tabs = [{ id: ALL_CATEGORY, label: 'Todos', count: items.length }, ...portfolioCategories(items)];
const { booking, instagram } = publicLinks;
---
<section id="trabajos" class="showcase section-space scene" aria-labelledby="trabajos-title" data-showcase-section>
  {/* The seam between the two ways of exploring: the gold line that leaves the Mundo LUXE
    * and the brand diamond where the close-up begins. Decorative. */}
  <span class="world-seam" aria-hidden="true"><span class="seam-line"></span><Icon name="diamond" /></span>
  <div class="container">
    <div class="section-heading" data-showcase-heading>
      <div><p class="eyebrow">02 / Nuestros trabajos</p><h2 id="trabajos-title"><span class="heading-line">El resultado</span><br class="heading-break" /> <em class="heading-line">habla por sí solo.</em></h2></div>
      <p class="section-intro"><span class="intro-kicker">Cada detalle, de cerca</span>Cortes, color, uñas y acabados hechos en LUXE. Descubrí nuestro trabajo de cerca.</p>
    </div>
    {first ? (
      <luxe-showcase>
        <div class="showcase-tabs" data-tabs hidden>
          <div class="showcase-tablist" role="tablist" aria-label="Especialidades" data-tablist>
            {tabs.map((tab, index) => (
              <button type="button" role="tab" id={`showcase-tab-${tab.id}`} data-category={tab.id} aria-controls="showcase-panel" aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1}>
                <span>{tab.label}</span><span class="tab-count" aria-hidden="true">{String(tab.count).padStart(2, '0')}</span>
              </button>
            ))}
            <span class="showcase-indicator" data-indicator aria-hidden="true"></span>
          </div>
          <span class="tabs-more" aria-hidden="true"><Icon name="arrow-right" /></span>
        </div>
        <div class="showcase-panel" id="showcase-panel" data-panel>
          <div class="crown-stage" data-stage role="group" aria-label="Trabajos de LUXE">
            <ul class="crown-track" role="list">
              {items.map((item, index) => <ShowcasePhoto item={item} order={index} />)}
            </ul>
            <span class="crown-floor" aria-hidden="true"></span>
          </div>
          <div class="showcase-copy">
            <div class="showcase-text">
              <p class="showcase-meta"><Icon name="diamond" /><span data-slot="category">{first.categoryLabel}</span><span class="showcase-caption" data-slot="tagline">{first.tagline}</span></p>
              <h3 class="showcase-title" data-slot="title">{first.title}</h3>
              <p class="showcase-description" data-slot="description">{first.description}</p>
            </div>
            <div class="showcase-actions">
              <p class="showcase-numeral" aria-hidden="true" data-slot="numeral">01</p>
              <div class="showcase-nav" role="group" aria-label="Recorrer trabajos" data-nav hidden>
                <button type="button" class="showcase-step" data-step="-1" aria-label="Trabajo anterior"><Icon name="arrow-left" /></button>
                <p class="showcase-counter">
                  <span aria-hidden="true" data-slot="counter">{formatCounter(0, items.length)}</span>
                  <span class="sr-only" data-slot="position">Trabajo 1 de {items.length}</span>
                  <span class="showcase-progress" aria-hidden="true"><span data-progress></span></span>
                </p>
                <button type="button" class="showcase-step" data-step="1" aria-label="Trabajo siguiente"><Icon name="arrow-right" /></button>
              </div>
              <div class="showcase-buttons">
                {booking && <ExternalLink href={booking} class="button showcase-cta"><span data-slot="cta">{first.ctaLabel}</span><Icon name="arrow-up-right" /></ExternalLink>}
                <button type="button" class="showcase-zoom" data-zoom hidden><Icon name="expand" /><span>Ver en grande</span></button>
              </div>
              {instagram && <ExternalLink href={instagram} class="text-link showcase-more">Más trabajos en Instagram <Icon name="arrow-up-right" /></ExternalLink>}
            </div>
          </div>
          <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-status></p>
        </div>
      </luxe-showcase>
      <script>import '../../scripts/showcase';</script>
    ) : (
      <div class="showcase-empty" data-showcase-empty>
        <Icon name="diamond" class="showcase-empty-mark" />
        <div>
          <p class="showcase-empty-title">Cada trabajo merece<br /><em>su momento.</em></p>
          <p>Pronto compartiremos aquí una selección de trabajos. Mientras tanto, conocé más en nuestro Instagram o reservá tu cita.</p>
          <div class="showcase-empty-actions">
            {booking && <ExternalLink href={booking} class="button">Reservar cita <Icon name="arrow-up-right" /></ExternalLink>}
            {instagram && <ExternalLink href={instagram} class="button button--ghost">Ver Instagram <Icon name="instagram" /></ExternalLink>}
          </div>
        </div>
      </div>
    )}
    {previewsUnapprovedMedia() && first && <p class="section-note">Previsualización local · Estas fotografías están pendientes de autorización para publicación. La limpieza facial se muestra en proceso, no como resultado final.</p>}
  </div>
</section>
<style>
  .showcase { position: relative; background: radial-gradient(70% 50% at 50% 40%, #103d3259, transparent 72%), var(--ink); }
  /* Straddles the edge between the ivory Mundo LUXE and this dark gallery. */
  .world-seam { position: absolute; top: 0; left: 50%; z-index: 1; display: grid; justify-items: center; gap: .55rem; color: var(--gold); transform: translate(-50%, -2.6rem); pointer-events: none; }
  .seam-line { display: block; width: 1px; height: 3.6rem; background: linear-gradient(#103d3200, var(--gold) 70%); transform-origin: 50% 0; }
  .world-seam :global(.icon) { width: 1.15rem; height: 1.15rem; }
  .heading-line { display: inline-block; }
  luxe-showcase { display: block; }
  .showcase-tabs { position: relative; margin-bottom: clamp(1.25rem, 3cqi, 2.25rem); border-bottom: 1px solid #c5a36a33; }
  /* Tabs carry their own inline padding so the focus ring never cuts the label. */
  .showcase-tablist { position: relative; display: flex; gap: clamp(.8rem, 2.6cqi, 2.2rem); margin-inline: -.45rem; overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: none; padding-right: 2.5rem; }
  .showcase-tablist::-webkit-scrollbar { display: none; }
  /* More categories beyond the edge: a fade plus an arrow, never a silently cut tab. */
  .tabs-more { position: absolute; top: 0; right: 0; bottom: 1px; display: grid; place-items: center end; width: 4rem; padding-right: .2rem; background: linear-gradient(90deg, #10121100, var(--ink) 62%); color: var(--gold); pointer-events: none; opacity: 0; }
  .tabs-more :global(.icon) { width: 1.1rem; height: 1.1rem; }
  .showcase-tabs[data-more] .tabs-more { opacity: 1; }
  [role='tab'] { flex: none; display: inline-flex; align-items: baseline; gap: .45rem; min-height: 52px; padding: .8rem .45rem; border: 0; background: none; color: var(--color-muted); font-size: .875rem; letter-spacing: .03em; white-space: nowrap; }
  [role='tab']:hover, [role='tab'][aria-selected='true'] { color: var(--ivory); }
  [role='tab']:focus-visible { outline-offset: -3px; }
  .tab-count { color: var(--gold); font-size: .625rem; letter-spacing: .12em; }
  .showcase-indicator { position: absolute; left: 0; bottom: 0; width: 1px; height: 2px; background: var(--gold); transform-origin: 0 50%; transform: scaleX(0); }

  .showcase-panel { display: grid; gap: clamp(1.5rem, 3cqi, 2.5rem); }
  /* The crown: a 3D viewport wider than any photo, clipped so it never reaches the copy. */
  .crown-stage { position: relative; isolation: isolate; container: crown / size; height: clamp(22rem, 118cqi, 31rem); margin-inline: calc(var(--gutter) * -1); overflow: hidden; perspective: 950px; perspective-origin: 50% 30%; touch-action: pan-y; -webkit-user-select: none; user-select: none; --crown-h: 80cqh; }
  /* perspective must sit on the cards' direct parent to project them in 3D. */
  .crown-track { position: absolute; inset: 0; margin: 0; padding: 0; perspective: inherit; perspective-origin: inherit; }
  .crown-floor { position: absolute; left: 18%; right: 18%; bottom: 3%; height: 1px; background: linear-gradient(90deg, transparent, #c5a36a59, transparent); }
  luxe-showcase:not([data-ready]) .crown-track > :global(.crown-card:not(:first-child)) { display: none; }
  /* Swipes belong to the crown: a finger resting on a photo never opens the iOS image menu. */
  luxe-showcase[data-ready] .crown-stage { cursor: grab; -webkit-touch-callout: none; }
  luxe-showcase[data-ready] .crown-stage[data-dragging] { cursor: grabbing; }
  .crown-stage:focus-visible { outline: 2px solid var(--gold); outline-offset: -4px; }
  .crown-track > :global([data-off]) { display: none; }

  .showcase-copy { position: relative; display: grid; gap: 1.5rem; min-width: 0; }
  .showcase-meta { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem .7rem; color: var(--gold); font-size: .6875rem; letter-spacing: .16em; text-transform: uppercase; }
  .showcase-meta :global(.icon) { width: 1.1rem; height: 1.1rem; }
  .showcase-caption { color: var(--color-muted); font-size: .75rem; letter-spacing: .04em; text-transform: none; }
  .showcase-caption::before { content: '—'; margin-right: .7rem; color: #c5a36a99; }
  .showcase-numeral { display: none; }
  /* Two lines reserved, text sits on the baseline: one-line titles add space above, not a gap below. */
  .showcase-title { display: flex; align-items: flex-end; min-height: 2.16em; margin: .9rem 0 .8rem; font: 400 clamp(2rem, 4.2cqi, 3.25rem)/1.08 var(--font-display); letter-spacing: -.02em; }
  .showcase-description { max-width: 32rem; min-height: 5.1em; color: var(--color-muted); font-size: .9375rem; line-height: 1.7; }
  .showcase-actions { position: relative; display: grid; gap: 1.25rem; align-content: start; }
  .showcase-buttons { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1rem; }
  .showcase-cta { flex: 1 1 15rem; max-width: 26rem; }
  .showcase-zoom { display: inline-flex; align-items: center; gap: .55rem; min-height: 52px; padding: .5rem 1rem; border: 1px solid #c5a36a66; background: none; color: var(--ivory); font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; }
  .showcase-zoom :global(.icon) { width: 1rem; height: 1rem; color: var(--gold); }
  .showcase-zoom:hover { border-color: var(--gold); color: var(--gold); }
  .showcase-zoom[hidden] { display: none; }
  .showcase-nav { display: flex; align-items: center; gap: 1rem; max-width: 26rem; }
  .showcase-step { position: relative; display: grid; place-items: center; width: 52px; height: 52px; padding: 0; border: 0; background: none; color: var(--ivory); }
  .showcase-step::before { content: ''; position: absolute; inset: 10px; border: 1px solid #c5a36a80; transform: rotate(45deg); }
  .showcase-step:hover:not(:disabled) { color: var(--gold); }
  .showcase-step:hover:not(:disabled)::before { border-color: var(--gold); }
  .showcase-step:disabled { opacity: .35; cursor: default; }
  .showcase-counter { flex: 1; display: grid; gap: .55rem; justify-items: center; font-size: .75rem; letter-spacing: .22em; }
  .showcase-progress { display: block; width: 100%; height: 1px; overflow: hidden; background: #c5a36a33; }
  .showcase-progress span { display: block; height: 100%; background: var(--gold); transform-origin: 0 50%; transform: scaleX(.1); }
  .showcase-more { justify-self: start; color: var(--color-muted); }

  .showcase-empty { display: grid; gap: 2rem; align-items: center; padding-block: clamp(2rem, 5cqi, 4rem); border-block: 1px solid #c5a36a40; }
  .showcase-empty :global(.showcase-empty-mark) { width: clamp(5rem, 14cqi, 9rem); height: auto; color: var(--gold); }
  .showcase-empty-title { margin-bottom: 1rem; font: 400 clamp(2rem, 5cqi, 3.5rem)/1.1 var(--font-display); }
  .showcase-empty-title em { color: var(--gold); }
  .showcase-empty p:not(.showcase-empty-title) { max-width: 32rem; color: var(--color-muted); }
  .showcase-empty-actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; }

  @container crown (min-width: 44rem) {
    .crown-track { --crown-h: 86cqh; }
  }
  .intro-kicker { display: block; margin-bottom: .35rem; color: var(--gold); font: italic 400 1.05rem/1.3 var(--font-display); letter-spacing: .01em; }
  @container (min-width: 52rem) {
    .crown-stage { height: clamp(27rem, 66svh, 38rem); margin-inline: 0; }
    .showcase-copy { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: start; column-gap: clamp(2.5rem, 6cqi, 6rem); padding-top: 1.5rem; border-top: 1px solid #c5a36a26; }
    .showcase-numeral { display: block; position: absolute; top: -.3em; right: 0; color: transparent; font: 400 clamp(5rem, 8cqi, 7.5rem)/1 var(--font-display); -webkit-text-stroke: 1px #c5a36a4d; pointer-events: none; }
    .showcase-actions { padding-top: 2.75rem; }
    .showcase-empty { grid-template-columns: auto 1fr; gap: clamp(2rem, 6cqi, 6rem); }
  }
  /* Desktop: the crown dominates the left two thirds; the work's story, the way through and
   * the actions stand beside it, so the whole gallery is read at once. */
  @container (min-width: 60rem) {
    .showcase-panel { grid-template-columns: minmax(0, 1.75fr) minmax(17rem, 1fr); align-items: center; column-gap: clamp(1.5rem, 3.5cqi, 3.5rem); }
    .crown-stage { margin-inline: calc(var(--gutter) * -.35) 0; }
    .showcase-copy { grid-template-columns: 1fr; gap: clamp(1rem, 2.6svh, 1.75rem); padding: 0 0 0 clamp(1.25rem, 2.6cqi, 2.25rem); border-top: 0; border-left: 1px solid #c5a36a26; }
    .showcase-title { margin: clamp(.5rem, 1.4svh, .9rem) 0 clamp(.45rem, 1.2svh, .8rem); font-size: clamp(1.75rem, min(2.6cqi, 4.6svh), 2.6rem); }
    .showcase-description { min-height: 5.1em; }
    .showcase-actions { padding-top: 0; gap: clamp(.85rem, 2.2svh, 1.25rem); }
    .showcase-actions { position: static; }
    .showcase-numeral { top: -.15em; right: 0; font-size: clamp(3.5rem, 5cqi, 5.25rem); }
    .showcase-cta { flex-basis: 100%; max-width: none; }
  }
  /* Desktop scene: title on one line, the crown as tall as the screen leaves it. */
  @media (min-width: 64rem) and (min-height: 34rem) {
    .heading-break { display: none; }
    .showcase .section-heading { margin-bottom: clamp(.75rem, 2.2svh, 1.75rem); }
    .showcase-tabs { margin-bottom: clamp(.75rem, 2.4svh, 1.75rem); }
    [role='tab'] { min-height: 48px; padding-block: .65rem; }
    .crown-stage { height: clamp(22rem, calc(var(--scene-avail) - var(--scene-title) * 1.04 - 8.6rem - 4.6svh), 40rem); }
  }
  /* Editorial entrance, once, as the section arrives (scripts/showcase.ts): the seam draws,
   * the title rises line by line, then the works and their story. Never without JS. */
  .showcase[data-reveal='pending'] :is(.seam-line, .world-seam :global(.icon), .eyebrow, .heading-line, .section-intro, .showcase-tabs, .crown-stage, .showcase-copy) { opacity: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .showcase[data-reveal='play'] .seam-line { animation: seam-draw 800ms cubic-bezier(.65, 0, .35, 1) both; }
    .showcase[data-reveal='play'] .world-seam :global(.icon) { animation: seam-diamond 700ms cubic-bezier(.22, 1, .36, 1) 520ms both; }
    .showcase[data-reveal='play'] .eyebrow { animation: reveal-fade 600ms ease 300ms both; }
    .showcase[data-reveal='play'] .heading-line { animation: reveal-rise 800ms cubic-bezier(.22, 1, .36, 1) 420ms both; }
    .showcase[data-reveal='play'] em.heading-line { animation-delay: 560ms; }
    .showcase[data-reveal='play'] .section-intro { animation: reveal-fade 700ms ease 700ms both; }
    .showcase[data-reveal='play'] .showcase-tabs { animation: reveal-fade 600ms ease 820ms both; }
    .showcase[data-reveal='play'] .crown-stage { animation: reveal-stage 900ms cubic-bezier(.22, 1, .36, 1) 880ms both; }
    .showcase[data-reveal='play'] .showcase-copy { animation: reveal-fade 700ms ease 1150ms both; }
    @keyframes seam-draw { from { opacity: 0; transform: scaleY(0); } to { opacity: 1; transform: none; } }
    @keyframes seam-diamond { from { opacity: 0; transform: rotate(-45deg) scale(.4); } to { opacity: 1; transform: none; } }
    @keyframes reveal-fade { from { opacity: 0; } to { opacity: 1; } }
    @keyframes reveal-rise { from { opacity: 0; transform: translateY(.35em); } to { opacity: 1; transform: none; } }
    @keyframes reveal-stage { from { opacity: 0; transform: translateY(1.5rem) scale(.985); } to { opacity: 1; transform: none; } }
  }
  @media (prefers-reduced-motion: no-preference) {
    .showcase-indicator { transition: transform 380ms cubic-bezier(.65, 0, .35, 1); }
    .showcase-progress span { transition: transform 420ms cubic-bezier(.22, 1, .36, 1); }
    [role='tab'] { transition: color 250ms ease; }
  }
</style>
