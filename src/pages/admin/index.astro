---
/** Private photo panel for LUXE. Rendered on the server for each request (never part of the
 * static site); the middleware has already checked the session. */
import { adminView } from '../../server/admin-view';
import { getAdminContext } from '../../server/admin-context';
import '../../styles/tokens.css';
import '../../styles/admin.css';

export const prerender = false;

const ready = getAdminContext();
if (!ready.ok) console.error(`[luxe-admin] ${ready.reason}`);
const admin = Astro.locals.admin;
const state = ready.ok && admin ? adminView(await ready.context.store.read(), await ready.context.publisher.describe()) : null;
---
<!doctype html>
<html lang="es-CR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="same-origin" />
    <meta name="theme-color" content="#101211" />
    <title>Panel de fotografías · LUXE</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {admin && <meta name="csrf-token" content={admin.session.csrf} />}
  </head>
  <body class="admin">
    {!ready.ok ? (
      <main class="admin-gate">
        <p class="admin-brand">LUXE<span>.</span></p>
        <h1>Panel no disponible</h1>
        <p class="admin-muted">El panel todavía no está configurado en este servidor.</p>
      </main>
    ) : !state ? (
      <main class="admin-gate">
        <form class="admin-login" data-login novalidate>
          <p class="admin-brand">LUXE<span>.</span></p>
          <h1>Panel de fotografías</h1>
          <label>Usuario<input name="username" autocomplete="username" required maxlength="64" autocapitalize="none" spellcheck="false" /></label>
          <label>Contraseña<input name="password" type="password" autocomplete="current-password" required maxlength="256" /></label>
          <p class="admin-error" data-login-error role="alert" hidden></p>
          <button class="admin-button admin-button--gold" type="submit">Ingresar</button>
        </form>
      </main>
    ) : (
      <>
        <header class="admin-bar">
          <p class="admin-brand">LUXE<span>.</span> <small>Fotografías</small></p>
          <div class="admin-bar__status" data-publish aria-live="polite"></div>
          <nav class="admin-bar__links">
            <a href="/" target="_blank" rel="noopener">Ver sitio ↗</a>
            <button type="button" class="admin-link" data-logout>Cerrar sesión</button>
          </nav>
        </header>
        <nav class="admin-tabs" aria-label="Secciones de la página" data-tabs>
          <button type="button" data-tab="portada">Portada</button>
          <button type="button" data-tab="trabajos">Trabajos</button>
          <button type="button" data-tab="globe">Mundo LUXE</button>
          <button type="button" data-tab="espacio">Espacio</button>
          <button type="button" data-tab="fachada">Fachada</button>
        </nav>
        <main class="admin-main" data-panel tabindex="-1"></main>
        <div class="admin-toasts" data-toasts role="status" aria-live="polite"></div>
        <script type="application/json" id="admin-state" set:html={JSON.stringify(state).replaceAll('<', '\\u003c')} />
      </>
    )}
    <script>
      import '../../scripts/admin/panel.ts';
    </script>
  </body>
</html>
