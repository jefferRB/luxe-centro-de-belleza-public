---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { crownPose, crownStyleText } from '../../lib/space-orbit';
/** The orbital crown of «El espacio»: one card per view riding a golden ellipse (a ring
 * of Saturn) that crosses in front of the portal. The server composes the ring at rest,
 * so it reads correctly without JavaScript; space-crown.ts turns it. */
interface CrownView { readonly area: string; readonly title: string; readonly description: string; readonly image: ImageMetadata }
interface Props { views: readonly CrownView[] }
const { views } = Astro.props;
const ring = 'M0 50a100 50 0 1 0 200 0a100 50 0 1 0-200 0';
---
<div class="tour-crown" data-tour-crown>
  <div class="tour-ring" data-tour-ring aria-hidden="true">
    <svg viewBox="0 0 200 100" preserveAspectRatio="none" focusable="false">
      <defs>
        <!-- Far side faint, near side bright: the ring is read in depth. -->
        <linearGradient id="tour-ring-depth" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#c5a36a" stop-opacity=".18" />
          <stop offset=".55" stop-color="#c5a36a" stop-opacity=".5" />
          <stop offset="1" stop-color="#e6cf9f" stop-opacity=".95" />
        </linearGradient>
        <linearGradient id="tour-ring-glint" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#f1eadf" stop-opacity="0" />
          <stop offset=".5" stop-color="#f6e7c4" stop-opacity=".95" />
          <stop offset="1" stop-color="#f1eadf" stop-opacity="0" />
        </linearGradient>
      </defs>
      <ellipse class="tour-ring-outer" cx="100" cy="50" rx="114" ry="63" vector-effect="non-scaling-stroke" />
      <ellipse class="tour-ring-halo" cx="100" cy="50" rx="100" ry="50" vector-effect="non-scaling-stroke" />
      <path class="tour-ring-main" d={ring} pathLength="1" vector-effect="non-scaling-stroke" />
      <ellipse class="tour-ring-inner" cx="100" cy="50" rx="86" ry="39" vector-effect="non-scaling-stroke" />
      <path class="tour-ring-glint" d={ring} pathLength="100" vector-effect="non-scaling-stroke" />
    </svg>
  </div>
  <ol class="tour-thumbs" aria-label="Ambientes de LUXE" data-tour-thumbs>
    {views.map((view, index) => (
      <li class="tour-thumb" data-tour-thumb={index} data-front={index === 0 ? '' : undefined} data-area={view.area} data-title={view.title} data-description={view.description} style={crownStyleText(crownPose(index, views.length))}>
        <span class="tour-thumb-media"><Picture src={view.image} alt="" formats={['webp']} fallbackFormat="jpg" widths={[120, 200]} sizes="4rem" quality={70} loading="lazy" decoding="async" draggable="false" /></span>
        <span class="tour-thumb-text">
          <span class="tour-thumb-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span class="tour-thumb-area">{view.area}</span>
          <span class="tour-thumb-title">{view.title}</span>
        </span>
      </li>
    ))}
  </ol>
</div>
<style>
  /* Geometry tokens (--rx, --ry, --card-w, --card-h, --ring-cy) are set on .tour. */
  .tour-crown { position: relative; z-index: 2; height: var(--crown-h); touch-action: pan-y; -webkit-user-select: none; user-select: none; --crown-back-scale: .64; --crown-back-opacity: .74; --crown-facing: 26; }
  :global(luxe-space-tour[data-ready]) .tour-crown { cursor: grab; }
  .tour-crown[data-dragging] { cursor: grabbing; }

  .tour-ring { position: absolute; left: 50%; top: var(--ring-cy); width: calc(var(--rx) * 2); height: calc(var(--ry) * 2); transform: translate(-50%, -50%) translate(calc(var(--px, 0) * 3px), calc(var(--py, 0) * 2px)); pointer-events: none; }
  .tour-ring svg { display: block; width: 100%; height: 100%; overflow: visible; fill: none; }
  .tour-ring-main { stroke: url(#tour-ring-depth); stroke-width: 1.15px; }
  .tour-ring-halo { stroke: #c5a36a; stroke-opacity: .07; stroke-width: 7px; }
  .tour-ring-outer { stroke: #c5a36a; stroke-opacity: .22; stroke-width: .75px; }
  .tour-ring-inner { stroke: #c5a36a; stroke-opacity: .14; stroke-width: .75px; stroke-dasharray: 1 5; }
  /* A short reflection travelling the ring, extremely slowly. Static when motion is reduced. */
  .tour-ring-glint { stroke: url(#tour-ring-glint); stroke-width: 1.6px; stroke-linecap: round; stroke-dasharray: 7 93; stroke-dashoffset: -38; opacity: .85; }

  .tour-thumbs { position: absolute; inset: 0; margin: 0; padding: 0; list-style: none; perspective: 1100px; perspective-origin: 50% var(--ring-cy); }
  .tour-thumb {
    position: absolute; left: 50%; top: var(--ring-cy); display: grid; grid-template-columns: var(--thumb-w) minmax(0, 1fr); align-items: center; gap: .65rem;
    width: var(--card-w); height: var(--card-h); padding: .4rem .7rem .4rem .4rem; border: 1px solid #c5a36a3d; border-radius: .85rem;
    background: linear-gradient(155deg, #164a3cf0, #08201af5 60%, #061511f8); box-shadow: 0 1.1rem 1.8rem -.8rem #000d, inset 0 1px 0 #f1eadf14;
    transform: translate(calc(var(--ox) * var(--rx) - 50%), calc(var(--oy) * var(--ry) - 50%)) rotateY(var(--turn)) scale(var(--scale));
    transform-origin: 50% 50%; backface-visibility: hidden; will-change: transform;
  }
  /* Depth: cards further back sink into the dark. */
  .tour-thumb::after { content: ''; position: absolute; inset: -1px; border-radius: inherit; background: #030a08; opacity: calc((1 - var(--depth)) * .38); pointer-events: none; }
  .tour-thumb-media { position: relative; display: block; overflow: hidden; width: var(--thumb-w); height: calc(var(--card-h) - .8rem - 2px); border-radius: .55rem; }
  .tour-thumb-media :global(picture), .tour-thumb-media :global(img) { display: block; width: 100%; height: 100%; }
  .tour-thumb-media :global(img) { object-fit: cover; -webkit-user-drag: none; }
  .tour-thumb-text { display: grid; align-content: center; min-width: 0; line-height: 1.25; }
  .tour-thumb-number { color: var(--gold); font-size: .625rem; letter-spacing: .2em; }
  .tour-thumb-area { overflow: hidden; color: var(--ivory); font-size: .8125rem; text-overflow: ellipsis; white-space: nowrap; }
  .tour-thumb-title { display: -webkit-box; overflow: hidden; margin-top: .1rem; color: var(--color-muted); font-size: .6875rem; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; }

  /* The card at the front: gilded edge, a soft light under it, nothing dimmed. */
  .tour-thumb[data-front] { border-color: #d9bc85; background: linear-gradient(155deg, #1d5847f5, #0b2a22f8 58%, #071813fa); box-shadow: 0 0 0 1px #c5a36a40, 0 0 2.25rem -.25rem #c5a36a4d, 0 1.4rem 2.2rem -.9rem #000e, inset 0 1px 0 #f6e7c440; }
  .tour-thumb[data-front]::before { content: ''; position: absolute; left: 14%; right: 14%; top: -1px; height: 1px; background: linear-gradient(90deg, transparent, #f6e7c4, transparent); }
  .tour-thumb[data-front] .tour-thumb-title { color: #dcd5c8; }
  :global(luxe-space-tour[data-ready]) .tour-thumb { cursor: pointer; }
  :global(luxe-space-tour[data-ready]) .tour-crown[data-dragging] .tour-thumb { cursor: grabbing; }
  .tour-thumb:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }

  /* Camera mode (scripts/space-scene.ts): each card is projected by its own matrix and ordered
   * with the portal, so the crown no longer groups the cards above it, and the rings are drawn
   * in depth by SpaceRings (this static ring only keeps the measurements). */
  :global(luxe-space-tour[data-camera]) .tour-crown { z-index: auto; }
  :global(luxe-space-tour[data-camera]) .tour-thumbs { perspective: none; }
  :global(luxe-space-tour[data-camera]) .tour-ring { visibility: hidden; }

  @container (max-width: 40rem) {
    .tour-crown { margin-inline: calc(var(--gutter) * -1); overflow-x: clip; --crown-facing: 22; --crown-back-scale: .66; }
    .tour-thumb { gap: .5rem; padding: .35rem .55rem .35rem .35rem; border-radius: .7rem; }
    .tour-thumb-media { height: calc(var(--card-h) - .7rem - 2px); border-radius: .45rem; }
    .tour-thumb-area { font-size: .75rem; }
    .tour-thumb-title { font-size: .625rem; }
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(luxe-space-tour[data-ambient]) .tour-ring-glint { animation: tour-glint 64s linear infinite; }
    :global(luxe-space-tour[data-ambient]:not([data-inview])) .tour-ring-glint { animation-play-state: paused; }
    @keyframes tour-glint { from { stroke-dashoffset: -38; } to { stroke-dashoffset: -138; } }
    .tour-thumb { transition: border-color 320ms ease, box-shadow 320ms ease, background-color 320ms ease; }
    .tour-ring { transition: transform 900ms cubic-bezier(.22, 1, .36, 1); }
    /* Entrance: the main ring draws itself once, then the crown settles (space-tour.ts). */
    :global(luxe-space-tour[data-reveal='pending']) .tour-crown { opacity: 0; }
    :global(luxe-space-tour[data-reveal='pending']) .tour-ring-main { stroke-dasharray: 1; stroke-dashoffset: 1; }
    :global(luxe-space-tour[data-reveal='run']) .tour-crown { animation: tour-crown-in 900ms 120ms cubic-bezier(.22, 1, .36, 1) both; }
    :global(luxe-space-tour[data-reveal='run']) .tour-ring-main { stroke-dasharray: 1; animation: tour-ring-draw 1500ms 80ms cubic-bezier(.65, 0, .35, 1) both; }
    /* With the camera, the cards fade in one by one instead of the whole band (a fading band
     * would group them above the portal for the length of the entrance). */
    :global(luxe-space-tour[data-camera][data-reveal='pending']) .tour-crown { opacity: 1; }
    /* Opacity, not visibility: before the entrance the cards stay focusable and reachable. */
    :global(luxe-space-tour[data-camera][data-reveal='pending']) .tour-thumb { opacity: 0 !important; }
    :global(luxe-space-tour[data-camera][data-reveal='run']) .tour-crown { animation: none; }
    :global(luxe-space-tour[data-camera][data-reveal='run']) .tour-thumb { animation: tour-crown-in 900ms 120ms cubic-bezier(.22, 1, .36, 1) both; }
    @keyframes tour-crown-in { from { opacity: 0; } to { opacity: 1; } }
    @keyframes tour-ring-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  }
</style>
