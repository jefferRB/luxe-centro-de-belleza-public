# nginx example (Ubuntu). Generic paths and domain: adapt every value before use.
#   Public site: static files from /var/lib/app/site/current (switched atomically on publish).
#   Admin:       only /admin/ is proxied to the Node process (luxe-admin.service) on loopback.

# In the http { } block (for example /etc/nginx/conf.d/app-limits.conf):
limit_req_zone $binary_remote_addr zone=app_admin:10m rate=10r/s;

# HTTP → canonical HTTPS host.
server {
    listen 80;
    listen [::]:80;
    server_name example.com www.example.com;
    return 301 https://www.example.com$request_uri;
}

# Apex over HTTPS → www (avoids duplicate content).
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name example.com;
    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
    return 301 https://www.example.com$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.example.com;
    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;

    root /var/lib/app/site/current;
    index index.html;
    charset utf-8;

    # nginx's add_header is not inherited by a location that sets its own headers, so the
    # security headers are repeated where needed.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Older nginx versions serve .webmanifest as application/octet-stream.
    # (Do not use `types { }` here: it would replace the whole inherited MIME map.)
    location = /site.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Hashed asset names: cache for a year.
    location /_astro/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        try_files $uri $uri/index.html =404;
    }

    # Private admin. The Node server checks session, origin and CSRF on every request and sets
    # its own strict headers (src/middleware.ts).
    location = /admin { return 301 /admin/; }
    location /admin/ {
        limit_req zone=app_admin burst=30 nodelay;
        client_max_body_size 16m;
        proxy_pass http://127.0.0.1:4322;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        # Replaced, never appended: login throttling trusts the first value as the client address.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 120s;
    }
}
