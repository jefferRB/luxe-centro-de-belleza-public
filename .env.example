# Environment reference. Placeholders only: never put real credentials in this file.
#
# Local development: `npm run admin:password -- --local` asks for a username and a password
# and writes `.env.admin` (git-ignored) with the username and an Argon2id hash. `astro dev`
# loads it (src/integrations/local-admin-env.ts). Without it, /admin stays disabled and the
# public site works normally.

# Admin account (server environment or .env.admin). Only the hash is ever stored.
LUXE_ADMIN_USER=
LUXE_ADMIN_PASSWORD_HASH=

# Production only (see deploy/README.md). Locally the media store defaults to ./.luxe-media
# and publishing is a no-op preview.
# LUXE_MEDIA_DIR=/var/lib/app/media
# LUXE_SITE_DIR=/var/lib/app/site
# LUXE_PROJECT_ROOT=/srv/app

# Optional admin end-to-end tests, against a local server with TEST credentials only.
# LUXE_E2E_ADMIN_URL=http://localhost:4321
# LUXE_E2E_USER=
# LUXE_E2E_PASSWORD=

# Optional: regenerate the WebM demo loops with `npm run demo-media` (ffmpeg with libvpx-vp9).
# FFMPEG_PATH=
