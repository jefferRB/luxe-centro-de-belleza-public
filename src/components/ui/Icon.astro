---
/** Original line icons drawn for LUXE (24px grid, 1.5 stroke). No icon library. */
export type IconName = 'arrow-up-right' | 'arrow-left' | 'arrow-right' | 'arrow-up' | 'arrow-down' | 'diamond' | 'whatsapp' | 'instagram' | 'pin' | 'close' | 'expand' | 'clock' | 'route' | 'chevron-down';
interface Props { name: IconName; class?: string }
const { name, class: className } = Astro.props;
---
<svg class:list={['icon', className]} viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'arrow-up-right' && <path d="M7 17 17 7M8.5 7H17v8.5" />}
  {name === 'arrow-left' && <path d="M19 12H5m6-6-6 6 6 6" />}
  {name === 'arrow-right' && <path d="M5 12h14m-6-6 6 6-6 6" />}
  {name === 'arrow-up' && <path d="M12 19V5m-6 6 6-6 6 6" />}
  {name === 'arrow-down' && <path d="M12 5v14m6-6-6 6-6-6" />}
  {name === 'chevron-down' && <path d="m6 9.5 6 6 6-6" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
  {name === 'expand' && <path d="M14.5 4.5h5v5M9.5 19.5h-5v-5M19.5 4.5 13.5 10.5M4.5 19.5l6-6" />}
  {name === 'clock' && <><circle cx="12" cy="12" r="8.25" /><path d="M12 7.5V12l3 2" /></>}
  {name === 'route' && <><path d="M6.5 19.5h7a3.5 3.5 0 0 0 0-7h-3a3.5 3.5 0 0 1 0-7h7" /><circle cx="5" cy="19.5" r="1.5" /><path d="m17 3.5 2 2-2 2" /></>}
  {name === 'diamond' && <path d="M7 4.5h10L21 9l-9 10.5L3 9l4-4.5ZM3 9h18M9.5 9 12 19.5 14.5 9M7 4.5 9.5 9 12 4.5 14.5 9 17 4.5" stroke-width="1.1" />}
  {name === 'whatsapp' && <>
    <path d="M20 11.6a8 8 0 0 1-11.7 7.1L4 20l1.3-4.1A8 8 0 1 1 20 11.6Z" />
    <path d="M9.1 8.4c.2-.4.5-.5.8-.5h.5c.2 0 .4.1.5.4l.6 1.5c.1.3 0 .5-.1.7l-.5.6c-.1.2-.1.4 0 .6.6.9 1.4 1.7 2.3 2.3.2.1.4.1.6 0l.6-.5c.2-.1.4-.2.7-.1l1.5.6c.3.1.4.3.4.5v.5c0 .3-.1.6-.5.8-.6.3-1.5.5-2.7 0-1.6-.6-3.1-2.1-3.7-3.7-.4-1.2-.3-2.1 0-2.7Z" stroke-width="1.1" />
  </>}
  {name === 'instagram' && <>
    <rect x="3.75" y="3.75" width="16.5" height="16.5" rx="4.75" />
    <circle cx="12" cy="12" r="3.9" />
    <circle cx="17.1" cy="6.9" r=".7" fill="currentColor" stroke="none" />
  </>}
  {name === 'pin' && <>
    <path d="M12 20.5s-6.25-5.4-6.25-10.6a6.25 6.25 0 0 1 12.5 0c0 5.2-6.25 10.6-6.25 10.6Z" />
    <circle cx="12" cy="9.9" r="2.3" />
  </>}
</svg>
