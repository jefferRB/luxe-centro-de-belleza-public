---
import Icon from './Icon.astro';
/** One shared viewer for every gallery (specialties, works, space). Native <dialog>:
 * modal focus containment, Escape and focus return come from the platform. */
---
<luxe-lightbox>
  <dialog class="lightbox" aria-labelledby="lightbox-caption" data-lightbox>
    <div class="lightbox-shell" data-lightbox-shell>
      <div class="lightbox-bar">
        <p class="lightbox-counter" data-lightbox-counter aria-hidden="true"></p>
        <button type="button" class="lightbox-close" data-lightbox-close aria-label="Cerrar visor"><Icon name="close" /></button>
      </div>
      <figure class="lightbox-figure">
        <div class="lightbox-frame" data-lightbox-frame>
          <img data-lightbox-image alt="" decoding="async" />
          <video data-lightbox-video muted playsinline loop controls preload="none" disablepictureinpicture hidden></video>
        </div>
        <figcaption id="lightbox-caption" data-lightbox-caption></figcaption>
      </figure>
      <button type="button" class="lightbox-step lightbox-step--prev" data-lightbox-step="-1" aria-label="Fotografía anterior"><Icon name="arrow-left" /></button>
      <button type="button" class="lightbox-step lightbox-step--next" data-lightbox-step="1" aria-label="Fotografía siguiente"><Icon name="arrow-right" /></button>
      <p class="sr-only" aria-live="polite" aria-atomic="true" data-lightbox-status></p>
    </div>
  </dialog>
</luxe-lightbox>
<script>import '../../scripts/lightbox';</script>
<style>
  .lightbox { width: 100vw; max-width: none; height: 100dvh; max-height: none; margin: 0; padding: 0; border: 0; background: #070b09f5; color: var(--ivory); overscroll-behavior: contain; }
  .lightbox::backdrop { background: #070b09cc; }
  .lightbox-shell { position: relative; display: grid; grid-template-rows: auto minmax(0, 1fr); height: 100%; padding: max(.75rem, env(safe-area-inset-top)) max(.75rem, env(safe-area-inset-right)) max(1rem, env(safe-area-inset-bottom)) max(.75rem, env(safe-area-inset-left)); }
  .lightbox-bar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding-inline: .5rem; }
  .lightbox-counter { color: var(--gold); font-size: .75rem; letter-spacing: .22em; }
  .lightbox-close { display: grid; place-items: center; width: 48px; height: 48px; padding: 0; border: 1px solid #c5a36a66; border-radius: 50%; background: #101211cc; color: var(--ivory); }
  .lightbox-close:hover { border-color: var(--gold); color: var(--gold); }
  .lightbox-figure { display: grid; grid-template-rows: minmax(0, 1fr) auto; gap: .9rem; min-height: 0; padding: .75rem 0 0; }
  .lightbox-frame { position: relative; min-height: 0; touch-action: pan-y pinch-zoom; }
  /* Absolute + contain: the whole photo always fits the frame, whatever its proportions. */
  .lightbox-frame img, .lightbox-frame video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .lightbox-frame img:not([src]) { visibility: hidden; }
  /* Sized by the clip itself (centred, never stretched): its controls span the video, not the frame. */
  .lightbox-frame video { left: 0; right: 0; width: auto; max-width: 100%; margin-inline: auto; background: transparent; }
  .lightbox-frame [hidden] { display: none; }
  figcaption { max-width: 46rem; margin-inline: auto; padding-inline: 3.5rem; color: #d3d8cf; font-size: .875rem; line-height: 1.6; text-align: center; }
  .lightbox-step { position: absolute; top: 50%; display: grid; place-items: center; width: 52px; height: 52px; padding: 0; border: 0; background: none; color: var(--ivory); transform: translateY(-50%); }
  .lightbox-step::before { content: ''; position: absolute; inset: 9px; border: 1px solid #c5a36a99; background: #101211b3; transform: rotate(45deg); }
  .lightbox-step :global(.icon) { position: relative; }
  .lightbox-step:hover { color: var(--gold); }
  .lightbox-step--prev { left: max(.5rem, env(safe-area-inset-left)); }
  .lightbox-step--next { right: max(.5rem, env(safe-area-inset-right)); }
  .lightbox :focus-visible { outline: 2px solid var(--gold); outline-offset: 4px; }
  /* The page behind a modal viewer does not scroll; the gutter avoids a layout shift. */
  :global(html:has(dialog.lightbox[open])) { overflow: hidden; }
  @media (min-width: 48rem) {
    .lightbox-shell { padding: 1.25rem 2rem 1.5rem; }
    .lightbox-figure { padding: 1rem 4.5rem 0; }
    .lightbox-step--prev { left: 1.5rem; }
    .lightbox-step--next { right: 1.5rem; }
  }
</style>
