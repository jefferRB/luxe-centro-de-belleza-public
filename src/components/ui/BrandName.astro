---
interface Props { name: string; descriptor: string }
const { name, descriptor } = Astro.props;
---
<span class="brand"><span class="name">{name}</span>{' '}<span class="descriptor">{descriptor}</span></span>
<style>
  .brand { display: inline-grid; max-width: 100%; gap: .2rem; }
  .name { font-family: var(--font-display); font-size: 2.5rem; line-height: 1; letter-spacing: .16em; }
  .descriptor { font-size: .625rem; text-transform: uppercase; letter-spacing: .12em; }
</style>
